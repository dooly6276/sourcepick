{
  // The service worker: WebWorker types instead of DOM types.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "WebWorker"],
    "types": [],
    "module": "ES2020",
    "moduleDetection": "legacy",
    "rootDir": "src",
    "outDir": ".build",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "alwaysStrict": false,
    "removeComments": false,
    "skipLibCheck": true
  },
  "files": ["src/web/sw.ts"]
}
