{
  "manifest_version": 3,
  "name": "Sourcepick",
  "version": "0.1.0",
  "description": "구글 검색 결과 화면에서 커뮤니티, 블로그, 카페처럼 원하는 출처의 결과만 볼 수 있습니다.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.kr/search*"
      ],
      "js": ["core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
