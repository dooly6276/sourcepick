{
  "name": "sourcepick",
  "version": "0.3.1",
  "private": true,
  "description": "Search only the sites you choose: forums, blogs, papers, docs and more. Web app and browser extension for Google, Bing, DuckDuckGo and Brave Search.",
  "homepage": "https://sourcepick.toolnjoy.com/",
  "repository": { "type": "git", "url": "https://github.com/dooly6276/sourcepick.git" },
  "bugs": "https://github.com/dooly6276/sourcepick/issues",
  "license": "MIT",
  "sourcepick": {
    "links": { "chrome": "", "firefox": "", "edge": "", "repo": "https://github.com/dooly6276/sourcepick" }
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "package": "node scripts/build.ts --zip",
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.node.json",
    "pretest": "npm run compile",
    "test": "node --test tests/*.test.ts",
    "check-domains": "node scripts/check-domains.ts",
    "serve": "node scripts/build.ts && python3 -m http.server 8791 --bind 127.0.0.1 --directory dist/web"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
