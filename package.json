{
  "name": "sourcepick",
  "version": "0.2.0",
  "private": true,
  "description": "Search only the sites you choose: forums, blogs, papers, docs and more. Web app and browser extension for Google, DuckDuckGo and Brave Search.",
  "homepage": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "test": "node --test tests/*.test.mjs",
    "check-domains": "node scripts/check-domains.mjs",
    "serve": "node scripts/build.mjs && python3 -m http.server 8791 --bind 127.0.0.1 --directory dist/web"
  },
  "engines": { "node": ">=18" }
}
